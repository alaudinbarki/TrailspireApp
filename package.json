{
  "name": "trailspire",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:offline": "expo start --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:offline": "expo run:ios --no-bundler",
    "web": "expo start --web",
    "android:prebuild": "npx expo prebuild -p android",
    "build:apk:local": "rm -rf android/app/.cxx android/app/build android/build node_modules/react-native-gesture-handler/android/build && cd android && ./gradlew assembleRelease",
    "apk:local": "npm run android:prebuild && npm run build:apk:local",
    "build:apk": "npm exec --yes --package eas-cli eas -- build -p android --profile preview",
    "build:apk:prod": "npm exec --yes --package eas-cli eas -- build -p android --profile production",
    "apk": "npm run build:apk:prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.2",
    "expo": "^55.0.4",
    "expo-blur": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-image": "~55.0.5",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-navigation-bar": "~55.0.9",
    "expo-router": "~55.0.3",
    "expo-status-bar": "~55.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "^5.1.0"
  },
  "private": true
}
